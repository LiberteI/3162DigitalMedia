img = imread('cameraman.jpg');
img = im2double(img);

% frequency domain
IMG = fft2(img);

% define a function to generate filters
% blurred image=h∗image
h = fspecial('disk', 4);
% frequency domain
H = psf2otf(h, size(img));

% blurred image
y = ifft2(H .* IMG);

% add Gaussian noise
noise = 0.01 * randn(size(y));
y_noisy = y + noise;


% ---- Original Image ----
figure;
imshow(img);
title('Original Image');
% ---- Blur ----
figure;
imshow(y, []);
title('Blurred Image');
% ---- Add Noise ----
figure;
imshow(y_noisy, []);
title('Blurred + Noisy Image');

% Wiener filter: G(u,v) = H* / (|H|^2 + Su / Sx)
% F(ixed img) = G * Y(broken img) 
% H: blur frequency domain
% H*: conjured H
% |H|: amplitude
% Su: noise power spectrum
% Sx
